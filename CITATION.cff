    given-names: Shaun
version: 0.1.2
license: Apache-2.0
repository-code: "https://github.com/bigangusmac67-oss/ReddMunro"
url: "https://reddmunro.com"
keywords:
  - observability
  - telemetry
  - redundancy
  - site-reliability-engineering
  - pre-registration
